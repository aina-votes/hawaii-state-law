# Obsidian per-machine UI state. The vault's content is tracked; the window
# layout and last-opened file are not.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Scratch
.tmp/
*.tmp
.tmp-*

# Python
__pycache__/
*.pyc

# SQLite build artifacts, deliberately NOT tracked. Derived from graph/*.json
# (which are tracked) by one command. A page-structured binary also has near-zero
# delta headroom: a one-row change reshuffles headers, b-tree pointers and the
# freelist across the whole file, so every commit stores a full copy forever, on
# every clone. graph/sections.json already gives a readable diff when law moves.
graph/*.db

# PDFs. Already-compressed binary; same permanent-history cost as above. Store the
# extracted text plus a SHA-256 manifest of the source PDF instead - the hash
# proves the text came from that fetch, and the harvester can re-pull on demand.
*.pdf

# frontier-sizing cache (rebuildable, 15 requests)
tools/.chapmap.json
